{
  "name": "backend",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn spring-boot:run",
        "cwd": "apps/backend"
      }
    },
    "liquibase:update": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn liquibase:update",
        "cwd": "apps/backend"
      }
    }
  }
}
